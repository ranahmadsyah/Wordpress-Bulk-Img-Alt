# WordPress connection (use an Application Password).
WORDPRESS_URL=https://cms-corporate.integrity-asia.com/id/
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Image generation: Gemini first, then OpenRouter on HTTP 429.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional: the separate Fetch Image AI alt-text feature uses OpenAI directly.
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-4o
